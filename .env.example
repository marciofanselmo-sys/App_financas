# Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite o arquivo .env.local no Git

# Supabase — encontre em: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Admin — e-mail do owner do SaaS (acesso ao painel /admin)
NEXT_PUBLIC_ADMIN_EMAIL=seu@email.com

# Opcional — só para gerar prints do catálogo de telas (nunca commitar)
# SCREENSHOT_PASSWORD=sua_senha_aqui
