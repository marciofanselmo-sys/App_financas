# Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite o arquivo .env.local no Git

# Supabase — encontre em: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Opcional — usado em redirects de auth no servidor (produção: https://noblifinance.com.br)
# NEXT_PUBLIC_SITE_URL=https://noblifinance.com.br

# Admin — role 'admin' em user_profiles (ver migration_security.sql)
# Não use variável pública com e-mail do owner no browser.

# Opcional — só para gerar prints do catálogo de telas (nunca commitar)
# SCREENSHOT_PASSWORD=sua_senha_aqui

# ── Cobrança (Cakto) ────────────────────────────────────────────────────────
# Chave de serviço do Supabase — SÓ no servidor, nunca com prefixo NEXT_PUBLIC.
# Ela ignora o RLS: é o webhook que grava a assinatura de um cliente que nem
# está logado no momento do pagamento.
SUPABASE_SERVICE_ROLE_KEY=

# Secret do webhook, gerado pela Cakto ao cadastrar o webhook no painel.
CAKTO_WEBHOOK_SECRET=

# Link do checkout da assinatura (o app acrescenta ?callback=<id do usuário>).
NEXT_PUBLIC_CAKTO_CHECKOUT_URL=

# Id da oferta anual na Cakto — sem ele, o app decide pelo nome da oferta.
CAKTO_OFFER_ID_ANUAL=

# ── E-mail transacional (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=NOBLI <boasvindas@noblifinance.com.br>
